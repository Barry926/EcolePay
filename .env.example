# Firebase — variables publiques lues par Vite
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chariow — variables privées, à définir dans les réglages Vercel uniquement
CHARIOW_API_KEY=
# Produit de test unique : utilisé comme repli pour toutes les formules si les IDs ci-dessous sont vides.
CHARIOW_PRODUCT_ID=
CHARIOW_PRODUCT_ID_STARTER=
CHARIOW_PRODUCT_ID_STANDARD=
CHARIOW_PRODUCT_ID_PREMIUM=

# URL publique de l’application pour les redirections post-paiement
APP_ORIGIN=https://votre-domaine.example
